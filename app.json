{
  "expo": {
    "name": "SpendWise",
    "slug": "SpendWise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/spendwise-icon.png",
    "scheme": "spendwise",
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFDE7",
        "foregroundImage": "./assets/images/spendwise-adaptive-foreground.png",
        "monochromeImage": "./assets/images/spendwise-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.smri29.spendwise",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDE7",
          "android": {
            "image": "./assets/images/spendwise-splash-brand.png",
            "imageWidth": 220
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/spendwise-adaptive-monochrome.png",
          "color": "#1A237E"
        }
      ],
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62765fa4-f837-416e-8048-3b369b98b1ec"
      }
    }
  }
}
